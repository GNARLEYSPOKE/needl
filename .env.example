# Supabase — create project at supabase.com, ca-central-1 region for Canada
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — create app at clerk.com, enable Google + LinkedIn OAuth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI — text-embedding-3-small for vector embeddings
OPENAI_API_KEY=

# Anthropic — claude-sonnet-4-6 for AI drafting + matching
ANTHROPIC_API_KEY=

# Resend — transactional email
RESEND_API_KEY=

# Stripe — per-chapter billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry — error tracking
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
